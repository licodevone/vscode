{
	"servers": {
		"context7": {
			"type": "http",
			"url": "https://mcp.context7.com/mcp"
		},
		"serena": {
			"type": "stdio",
			"command": ".tmp/uv/bin/uvx.exe",
			"args": [
				"--python",
				"3.13",
				"--from",
				"git+https://github.com/oraios/serena",
				"serena",
				"start-mcp-server",
				"--project-from-cwd",
				"--context",
				"ide-assistant",
				"--mode",
				"interactive",
				"--open-web-dashboard",
				"false"
			],
			"cwd": "${workspaceFolder}"
		},
		"openaiDeveloperDocs": {
			"type": "http",
			"url": "https://developers.openai.com/mcp"
		},
		"playwright": {
			"type": "stdio",
			"command": "pnpm",
			"args": [
				"dlx",
				"@playwright/mcp@0.0.86",
				"--headless",
				"--isolated",
				"--browser",
				"msedge",
				"--caps",
				"devtools",
				"--output-dir",
				".agent-validation/playwright"
			],
			"cwd": "${workspaceFolder}"
		},
		"component-explorer": {
			"type": "stdio",
			"command": "npm",
			"args": [
				"exec",
				"--no",
				"--",
				"component-explorer",
				"mcp",
				"-p",
				"./test/componentFixtures/component-explorer.json",
				"--use-daemon",
				"-vv"
			],
			"cwd": "${workspaceFolder}"
		}
	}
}
