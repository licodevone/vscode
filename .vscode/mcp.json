{
	"servers": {
		"openaiDeveloperDocs": {
			"type": "http",
			"url": "https://developers.openai.com/mcp"
		},
		"playwright": {
			"type": "stdio",
			"command": "pnpm",
			"args": [
				"dlx",
				"@playwright/mcp@0.0.86",
				"--headless",
				"--isolated",
				"--browser",
				"msedge",
				"--caps",
				"devtools",
				"--output-dir",
				".agent-validation/playwright"
			],
			"cwd": "${workspaceFolder}"
		},
		"component-explorer": {
			"type": "stdio",
			"command": "npm",
			"args": [
				"exec",
				"--no",
				"--",
				"component-explorer",
				"mcp",
				"-p",
				"./test/componentFixtures/component-explorer.json",
				"--use-daemon",
				"-vv"
			],
			"cwd": "${workspaceFolder}"
		}
	}
}
